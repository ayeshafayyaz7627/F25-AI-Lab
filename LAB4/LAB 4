ate experiment] h(C): 2 -> 10, true remaining cost of C = 3\n","\n","=== A* with h(C)=10 ===\n","  POP S: g=0, h=5, f=5\n","      push A: g=1, h=4, f=5\n","      push B: g=4, h=4, f=8\n","  POP A: g=1, h=4, f=5\n","      push C: g=3, h=10, f=13\n","  POP B: g=4, h=4, f=8\n","      push G: g=9, h=0, f=9\n","  POP G: g=9, h=0, f=9\n","Path: S -> B -> G\n","Returned cost: 9 | Independently summed cost: 9\n","Processed nodes: ['S', 'A', 'B', 'G']\n","Expanded nodes: ['S', 'A', 'B'] | Expansion count: 3\n"]}],"source":["import heapq\n","graph = {\"S\": [(\"A\", 1), (\"B\", 4)], \"A\": [(\"C\", 2)],\n","         \"B\": [(\"G\", 5)], \"C\": [(\"G\", 3)], \"G\": []}\n","h = {\"S\": 5, \"A\": 4, \"B\": 4, \"C\": 2, \"G\": 0}\n","true_cost = {\"S\": 6, \"A\": 5, \"B\": 5, \"C\": 3, \"G\": 0}\n","def astar(graph, h, start, goal, verbose=True):\n","    pq = [(h[start], 0, start, [start])]\n","    best = {start: 0}\n","    processed, expanded = [], []\n","    while pq:\n","        f, g, node, path = heapq.heappop(pq)\n","        if g != best[node]:\n","            continue\n","        processed.append(node)\n","        if verbose:\n","            print(f\"  POP {node}: g={g}, h={h[node]}, f={f}\")\n","        if node == goal:\n","            return g, path, processed, expanded\n","        expanded.append(node)\n","        for nxt, w in graph.get(node, []):\n","            ng = g + w\n","            if ng < best.get(nxt, float(\"inf\")):\n","                best[nxt] = ng\n","                heapq.heappush(pq, (ng + h[nxt], ng, nxt, path + [nxt]))\n","                if verbose:\n","                    print(f\"      push {nxt}: g={ng}, h={h[nxt]}, f={ng + h[nxt]}\")\n","    return None\n","def path_cost(path):\n","    total = 0\n","    for a, b in zip(path, path[1:]):\n","        total += dict(graph[a])[b]\n","    return total\n","def run(label, hh):\n","    print(f\"\\n=== {label} ===\")\n","    cost, path, proc, exp = astar(graph, hh, \"S\", \"G\")\n","    print(\"Path:\", \" 